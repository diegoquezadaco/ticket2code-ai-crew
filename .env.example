# Copy this file to .env. Never commit .env or real provider credentials.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
PLANNER_MODEL=openai/gpt-oss-20b
CODER_MODEL=openai/gpt-oss-120b
DOCUMENTARIAN_MODEL=qwen/qwen3.8-27b
REVIEWER_MODEL=qwen/qwen3.8-27b

# Optional: backup provider used when the primary fails (e.g. Google AI Studio)
FALLBACK_BASE_URL=http://localhost:11434/v1/
FALLBACK_MODEL=qwen2.5-coder:7b
FALLBACK_API_KEY=
FALLBACK_TIMEOUT=380

GROQ_TPM_BUDGET=7900
GROQ_TPM_BUDGET_OPENAI_GPT_OSS_20B=7900
GROQ_TPM_BUDGET_OPENAI_GPT_OSS_120B=7900
GROQ_TPM_BUDGET_QWEN_QWEN3_8_27B=7900
GROQ_WAIT_SECONDS=45
GROQ_COOLDOWN_SECONDS=60

# Coder retries after the first attempt (total attempts = MAX_RETRIES + 1)
MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=60
MAX_SESSIONS=400