# Copy to .env (never commit .env). Any OpenAI-compatible provider works.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# Optional: a different model per role (free-tier limits are per model, so splitting helps)
PLANNER_MODEL=
CODER_MODEL=
REVIEWER_MODEL=

# Optional: backup provider used when the primary fails (e.g. Google AI Studio)
FALLBACK_API_KEY=
FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
FALLBACK_MODEL=

# Coder retries after the first attempt (total attempts = MAX_RETRIES + 1)
MAX_RETRIES=5
LLM_TIMEOUT_SECONDS=60
MAX_SESSIONS=200